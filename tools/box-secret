#!/usr/bin/env bash
# box-secret: keep a secret for a profile's host hooks (~/.box.NAME.up) in the
# host keychain instead of a file, e.g. the password a PgBouncer holds for the
# box.
#
#   box-secret set NAME      store it (hidden prompt on a TTY, else read stdin)
#   box-secret get NAME      print it, for $(...) in a hook; refuses a terminal
#   box-secret remove NAME   delete it
#   box-secret show NAME     report whether it is set (never prints it)
#
# Stored in the host keychain (macOS: `security`; Linux: `secret-tool`) under
# the service box-secret. It is never written into a repo or ~/.box.*.
set -euo pipefail

usage() {
  echo "usage: box-secret set|get|remove|show NAME" >&2
  exit 2
}

[[ $# -eq 2 && -n $2 ]] || usage
cmd=$1 name=$2

case $(uname -s) in
  Darwin)
    get() { security find-generic-password -s box-secret -a "$name" -w 2>/dev/null; }
    put() { security add-generic-password -U -s box-secret -a "$name" -w "$1"; }
    del() { security delete-generic-password -s box-secret -a "$name" >/dev/null 2>&1; }
    ;;
  *)
    get() { secret-tool lookup service box-secret account "$name" 2>/dev/null; }
    put() { printf '%s' "$1" | secret-tool store --label="box-secret $name" service box-secret account "$name"; }
    del() { secret-tool clear service box-secret account "$name"; }
    ;;
esac

case $cmd in
  set)
    if [[ -t 0 ]]; then
      read -rsp "Secret for $name: " val
      echo
    else
      read -r val
    fi
    [[ -n $val ]] || { echo "error: empty secret" >&2; exit 1; }
    put "$val"
    echo "stored $name"
    ;;
  get)
    [[ ! -t 1 ]] || { echo "error: not printing $name to a terminal; use it in \$(...)" >&2; exit 1; }
    get || { echo "error: no secret $name (run \`box-secret set $name\`)" >&2; exit 1; }
    ;;
  remove)
    del && echo "removed $name" || echo "no secret $name"
    ;;
  show)
    if get >/dev/null; then echo "$name is set"; else echo "no secret $name"; fi
    ;;
  *)
    usage
    ;;
esac
