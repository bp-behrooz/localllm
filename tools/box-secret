#!/usr/bin/env bash
# box-secret: keep a secret for a profile's host hooks (~/.box.NAME.up) in the
# host keychain instead of a file, e.g. the password a PgBouncer holds for the
# box.
#
#   box-secret set NAME      store it (hidden prompt on a TTY, else read stdin)
#   box-secret get NAME      print it, for $(...) in a hook; refuses a terminal
#   box-secret remove NAME   delete it
#   box-secret show NAME     report whether it is set (never prints it)
#
# Stored in the host keychain (macOS: `security`; Linux: `secret-tool`) under
# the service box-secret. It is never written into a repo or ~/.box.*, nor
# passed to a command as an argument, where the process list would show it.
set -euo pipefail

usage() {
  echo "usage: box-secret set|get|remove|show NAME" >&2
  exit 2
}

[[ $# -eq 2 && -n $2 ]] || usage
cmd=$1 name=$2
# macOS's `security -i` reads NAME inside double quotes
[[ $name != *[\"\\]* && $name != *$'\n'* ]] || {
  echo "error: a name can't hold \", \\ or a newline" >&2
  exit 2
}

case $(uname -s) in
  Darwin)
    get() { security find-generic-password -s box-secret -a "$name" -w 2>/dev/null; }
    # On stdin, not argv: `security -i` reads the command from there, and -X
    # takes the secret as hex, which needs no quoting.
    put() {
      local hex
      hex=$(printf %s "$1" | od -An -v -tx1 | tr -d ' \n')
      # Its output is dropped, not shown: an error there may echo the command,
      # secret included.
      printf 'add-generic-password -U -s box-secret -a "%s" -X %s\n' "$name" "$hex" |
        security -i >/dev/null 2>&1 || {
        echo "error: security -i failed to store $name" >&2
        exit 1
      }
    }
    # On a terminal, `security` prompts for it (twice) itself.
    prompt_put() {
      echo "Secret for $name:" >&2
      security add-generic-password -U -s box-secret -a "$name" -w
    }
    del() { security delete-generic-password -s box-secret -a "$name" >/dev/null 2>&1; }
    ;;
  *)
    get() { secret-tool lookup service box-secret account "$name" 2>/dev/null; }
    put() { printf '%s' "$1" | secret-tool store --label="box-secret $name" service box-secret account "$name"; }
    prompt_put() {
      local val
      IFS= read -rsp "Secret for $name: " val
      echo >&2
      [[ -n $val ]] || { echo "error: empty secret" >&2; exit 1; }
      put "$val"
    }
    del() { secret-tool clear service box-secret account "$name"; }
    ;;
esac

case $cmd in
  set)
    if [[ -t 0 ]]; then
      prompt_put
    else
      # IFS= keeps leading and trailing spaces; a last line without a newline
      # still counts
      val=
      IFS= read -r val || true
      [[ -n $val ]] || { echo "error: empty secret" >&2; exit 1; }
      put "$val"
    fi
    # `security -i` can report success for a command that failed
    get >/dev/null || { echo "error: $name was not stored" >&2; exit 1; }
    echo "stored $name"
    ;;
  get)
    [[ ! -t 1 ]] || { echo "error: not printing $name to a terminal; use it in \$(...)" >&2; exit 1; }
    get || { echo "error: no secret $name (run \`box-secret set $name\`)" >&2; exit 1; }
    ;;
  remove)
    del && echo "removed $name" || echo "no secret $name"
    ;;
  show)
    if get >/dev/null; then echo "$name is set"; else echo "no secret $name"; fi
    ;;
  *)
    usage
    ;;
esac
