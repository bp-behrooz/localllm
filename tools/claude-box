#!/usr/bin/env bash
# claude-box: run Claude Code in an Apple `container` VM confined to $PWD,
# with all permissions granted (the VM is the sandbox).
#
# Unrelated to the rest of this repo: it talks to Anthropic as usual, the box
# is only here for the sandboxing.
#
#   claude-box [claude args...]  run (builds the image on first use)
#   claude-box --rebuild [args...] delete existing image, rebuild, then run
#   claude-box --build-only        (re)build the image and exit
#   claude-box --ssh [args...]     forward your ssh-agent into the box, and pass the
#                                 host's gh token along (same as CL_BOX_SSH=1)
#   claude-box --profile=NAME      read $CL_BOX_HOME/.env.NAME (lines like
#                                 `export SOME_VAR=SOME_VAL`) and pass its
#                                 variables into the box (same as CL_BOX_PROFILE)
#   claude-box --clean             drop the box's runtimes and caches, keep its login
#   claude-box --clean-all         delete CL_BOX_HOME entirely (asks first)
#
# Requires: Apple Silicon, macOS 26, `container` CLI (brew install container),
# and agent-box-lib.bash sitting next to this script.
#
# First run: log in inside the box (`/login`, or set ANTHROPIC_API_KEY); the
# credentials land in CL_BOX_HOME and are reused after that.
#
# CL_BOX_HOME is the box's entire /root, so anything the agent installs into the
# home directory survives the container being thrown away: mise runtimes, gems,
# ~/.npm, ~/.cargo, shell history. `mise use ruby@4.0.2 && bundle install` is a
# one-off, not a per-launch cost. System packages (apt) are not covered — those
# still belong in the image. --clean empties it again.
#
# Language runtimes come from mise: its shims are on PATH, so a project's own
# mise.toml applies in the non-interactive shells the agent runs commands in.
# See tools/README.md for the customization options.
#
# Env knobs:
#   CL_BOX_VERSION      npm version/tag of @anthropic-ai/claude-code (default "latest")
#   CL_BOX_HOME         host dir for the box's own Claude config/state (default ~/.claude-box)
#   ANTHROPIC_API_KEY   passed into the container if set, never written to disk
#   ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_MODEL  passed through if set
#   CL_BOX_YOLO         0 to keep Claude's own permission prompts (default 1:
#                       permissions.defaultMode=bypassPermissions, the VM is the
#                       boundary; the --dangerously-skip-permissions flag itself
#                       is refused because the box runs as root)
#   CL_BOX_TRUST        0 to keep the "do you trust this folder?" prompt (default
#                       1: projects[$PWD].hasTrustDialogAccepted is pre-set in
#                       the box's .claude.json)
#   CL_BOX_TUI          which renderer Claude uses. Default "default": the classic
#                       main-screen renderer, so the transcript scrolls into the
#                       terminal's own scrollback and stays there after the box
#                       exits (like `pi`). "fullscreen" is Claude's alt-screen
#                       renderer: flicker-free, but the session lives on the
#                       alternate screen and leaves no history behind, so scrolling
#                       back then needs CL_BOX_MOUSE.
#   CL_BOX_MOUSE        mouse reporting. Default 0: off, so the terminal's own
#                       click-drag selection/copy keeps working. "scroll": Claude
#                       sees the wheel (scrolling its own transcript) but not
#                       clicks, so selection still works. 1: full capture, wheel
#                       plus clickable file paths.
#   CL_BOX_CPUS / CL_BOX_MEMORY  VM sizing (default 4 / 4G)
#   CL_BOX_SSH          1: forward your ssh-agent into the box (container run --ssh)
#                       and, so `gh` works too, pass `gh auth token` from the host
#   CL_BOX_PROFILE      name of a profile: $CL_BOX_HOME/.env.NAME is read and its
#                       variables passed into the box (same as --profile=NAME)
#   CL_BOX_DOCKER       1: let the agent use your Mac's Docker engine. Bridges your
#                       Docker socket to TCP with socat and sets up Apple's localhost
#                       DNS domain for container->Mac traffic (sudo, once per boot).
#   CL_BOX_DOCKER_SOCK  path to the Docker socket (auto-detected; colima first)
#   CL_BOX_HOST_ALIAS   the localhost domain name (default host.container.internal)
#   CL_BOX_HOST_ALIAS_IP the IP the domain maps to (default 203.0.113.113)
set -euo pipefail

BOX_IMAGE="claude-box"
BOX_NAME_PREFIX="cl"
BOX_ENV_PREFIX="CL_BOX"

CL_VERSION="${CL_BOX_VERSION:-latest}"
CL_BOX_HOME="${CL_BOX_HOME:-$HOME/.claude-box}"
BOX_HOME="$CL_BOX_HOME"
BOX_KEEP=(.claude)

# ----------------------------------------------------------------- lib ------
# agent-box-lib.bash sits next to this script. Symlinks are followed, so
# `ln -s .../tools/claude-box ~/bin/claude-box` still finds it.
self="${BASH_SOURCE[0]}"
while [[ -L $self ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ $self == /* ]] || self="$dir/$self"
done
dir="$(cd -P "$(dirname "$self")" && pwd)"
[[ -r "$dir/agent-box-lib.bash" ]] || {
  echo "error: agent-box-lib.bash not found next to $dir/$(basename "$self")" >&2
  exit 1
}
# shellcheck source=agent-box-lib.bash
source "$dir/agent-box-lib.bash"

# ---------------------------------------------------------------- flags -----
REBUILD=0
BUILD_ONLY=0
CLEAN=
while [[ $# -gt 0 ]]; do
  case "$1" in
  --rebuild)
    REBUILD=1
    shift
    ;;
  --build-only)
    BUILD_ONLY=1
    shift
    ;;
  --clean)
    CLEAN=keep
    shift
    ;;
  --clean-all)
    CLEAN=all
    shift
    ;;
  --ssh)
    # Not dead: the lib reads it back as `box_knob SSH`, i.e. indirectly
    # through BOX_ENV_PREFIX, which shellcheck can't follow.
    # shellcheck disable=SC2034
    CL_BOX_SSH=1
    shift
    ;;
  --profile=*)
    # Not dead: the lib reads it back as `box_knob PROFILE`.
    # shellcheck disable=SC2034
    CL_BOX_PROFILE="${1#--profile=}"
    shift
    ;;
  --)
    shift
    break
    ;;
  *) break ;; # everything else goes to claude
  esac
done

# ------------------------------------------------------------- helpers ------
box_dockerfile_agent() {
  cat <<EOF
RUN npm install -g @anthropic-ai/claude-code@${CL_VERSION} \\
 && npm cache clean --force

# /root is the persisted mount, so Claude's own default location is already the
# right one; set it explicitly so creds and history can't wander.
ENV CLAUDE_CONFIG_DIR=/root/.claude

ENTRYPOINT ["claude"]
EOF
}

ensure_settings() {
  # Permission mode via settings, not --dangerously-skip-permissions: that flag is
  # refused when running as root. IS_SANDBOX=1 tells Claude it's already boxed in.
  # Also pre-accept the "do you trust this folder?" prompt for $PWD: the box only
  # ever sees the directory you launched it from, so the question is already
  # answered by running claude-box there.
  mkdir -p "$CL_BOX_HOME/.claude"
  CL_BOX_YOLO="${CL_BOX_YOLO:-1}" CL_BOX_TRUST="${CL_BOX_TRUST:-1}" \
    CL_BOX_TUI="${CL_BOX_TUI:-default}" \
    python3 - "$CL_BOX_HOME/.claude" "$PWD" <<'PYEOF'
import json, os, sys
from pathlib import Path

home, cwd = Path(sys.argv[1]), sys.argv[2]


def edit(name, fn):
    p = home / name
    s = json.loads(p.read_text()) if p.is_file() else {}
    before = json.dumps(s, sort_keys=True)
    fn(s)
    if json.dumps(s, sort_keys=True) != before:
        p.write_text(json.dumps(s, indent=2) + "\n")


mode = "bypassPermissions" if os.environ["CL_BOX_YOLO"] == "1" else "default"


def settings(s):
    s["permissions"] = {**s.get("permissions", {}), "defaultMode": mode}
    # Pin the renderer: left unset, Claude may switch itself to the alt-screen
    # one, and then the session leaves nothing in the terminal's scrollback.
    s["tui"] = os.environ["CL_BOX_TUI"]


edit("settings.json", settings)

if os.environ["CL_BOX_TRUST"] == "1":
    # .claude.json is Claude's own state file; touch just this one key.
    edit(".claude.json", lambda s: s.setdefault("projects", {})
         .setdefault(cwd, {}).update(hasTrustDialogAccepted=True))
PYEOF
}

# ---------------------------------------------------------------- main ------
if [[ -n $CLEAN ]]; then
  box_clean "$CLEAN"
  exit 0
fi

box_require_runtime
box_ensure_image "$REBUILD" "$BUILD_ONLY" "@anthropic-ai/claude-code@$CL_VERSION"

if [[ $BUILD_ONLY -eq 1 ]]; then
  exit 0
fi

ensure_settings

box_docker_bridge

# Full mouse reporting swallows click-drag, so the terminal can no longer select
# text. Off by default: with the main-screen renderer the wheel already scrolls
# the terminal's own scrollback, so there is nothing to gain by capturing it.
MOUSE_ENV=()
case "${CL_BOX_MOUSE:-0}" in
1) ;; # full capture: wheel + clickable paths
scroll) MOUSE_ENV=(--env CLAUDE_CODE_DISABLE_MOUSE_CLICKS=1) ;;
*) MOUSE_ENV=(--env CLAUDE_CODE_DISABLE_MOUSE=1) ;;
esac

# Claude's per-project history is keyed by path, and the project is mounted at
# its Mac path, so it stays separate per project.
# not exec: the socat trap must outlive claude
box_run_args
container run "${BOX_RUN_ARGS[@]}" \
  --env ANTHROPIC_API_KEY \
  --env ANTHROPIC_AUTH_TOKEN \
  --env ANTHROPIC_BASE_URL \
  --env ANTHROPIC_MODEL \
  --env IS_SANDBOX=1 \
  ${MOUSE_ENV[@]+"${MOUSE_ENV[@]}"} \
  "$BOX_IMAGE" "$@"
