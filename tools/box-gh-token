#!/usr/bin/env bash
# box-gh-token: store, show or remove the GitHub token the boxes pass to the
# agent with --gh. Keyed by the repo, so it works from any worktree of it.
#
#   box-gh-token set      store a token (hidden prompt on a TTY, else read stdin)
#   box-gh-token remove   delete the repo's token
#   box-gh-token show     report whether a token is set (never prints it)
#   box-gh-token get      print it, for --gh; refuses a terminal
#
# A box-secret named gh:<main worktree's path>, so in the host keychain. It is
# never written into the repo or ~/.box.*.
set -euo pipefail

# box-secret sits next to this script. Symlinks are followed, so
# `ln -s .../tools/box-gh-token ~/bin/box-gh-token` still finds it.
self="${BASH_SOURCE[0]}"
while [[ -L $self ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ $self == /* ]] || self="$dir/$self"
done
dir="$(cd -P "$(dirname "$self")" && pwd)"

# Outside git, key by $PWD so a multi-repo feature workspace (<branch>/<repo>)
# can hold one token for the whole feature.
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
  common="$(pwd -P)/.git"
key=$(dirname "$common")
name="gh:$key"

case ${1-} in
  set | remove | show)
    exec "$dir/box-secret" "$1" "$name"
    ;;
  get)
    [[ "$("$dir/box-secret" show "$name")" == "$name is set" ]] || {
      echo "error: no GitHub token for $key (run \`box-gh-token set\` in the main checkout)" >&2
      exit 1
    }
    exec "$dir/box-secret" get "$name"
    ;;
  *)
    echo "usage: box-gh-token set|remove|show|get" >&2
    exit 2
    ;;
esac
