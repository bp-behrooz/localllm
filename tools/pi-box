#!/usr/bin/env bash
# pi-box: run the pi coding agent in a `container` VM (podman on Linux)
# confined to $PWD.
#
#   pi-box [pi args...]        run pi (builds the image / syncs models on first use)
#   pi-box --rebuild [args...] delete existing pi-box image(s), rebuild, then run
#   pi-box --build-only        (re)build the image and exit
#   pi-box --sync [args...]    refresh the local model list from the server, then run
#   pi-box --sync-only         refresh the local model list and exit
#   pi-box --ssh [args...]     forward your ssh-agent into the box, and pass the
#                              host's gh token along (same as PI_BOX_SSH=1)
#   pi-box --docker [args...]  let the agent use the host's Docker / podman
#                              (same as PI_BOX_DOCKER=1)
#   pi-box --search [args...]  enable Tavily web search / fetch tools
#                              (same as PI_BOX_SEARCH=1; needs TAVILY_API_KEY)
#   pi-box --profile=NAME      read $PI_BOX_HOME/.env.NAME (lines like
#                              `export SOME_VAR=SOME_VAL`) and pass its
#                              variables into the box (same as PI_BOX_PROFILE; or --profile NAME)
#   pi-box --clean             drop the box's runtimes and caches, keep its config
#   pi-box --clean-all         delete PI_BOX_HOME entirely (asks first)
#   pi-box --clean-data        delete this profile and project's service data (asks first)
#   pi-box --shell [args]      bash in the box instead of the agent, for debugging
#
# PI_BOX_HOME is the box's entire /root, so anything the agent installs into the
# home directory survives the container being thrown away: mise runtimes, gems,
# ~/.npm, ~/.cargo, shell history. `mise use ruby@4.0.2 && bundle install` is a
# one-off, not a per-launch cost. System packages (apt) are not covered — those
# still belong in the image. --clean empties it again.
#
# Language runtimes come from mise: its shims are on PATH, so a project's own
# mise.toml applies in the non-interactive shells the agent runs commands in.
# See tools/README.md for the customization options.
#
# Requires: Apple Silicon, macOS 26, `container` CLI (brew install container),
# or Linux with rootless podman (see tools/README.md), and agent-box-lib.bash
# sitting next to this script.
#
# Env knobs:
#   PI_BOX_VERSION      npm version/tag of pi (default "latest")
#   PI_BOX_HOME         host dir for the box's own pi config/state (default ~/.pi-box)
#   LOCAL_LLM_URL       OpenAI-compatible base URL of your LLM server,
#                       e.g. https://llm.example.com/v1
#   LOCAL_LLM_API_KEY   its API key; passed into the container, never written to disk
#   PI_BOX_DEFAULT      default provider/model, e.g. "local/qwen3-coder" or
#                       "opencode-go/minimax-m2.7" (default local/<first synced model>)
#   OPENCODE_API_KEY    passed through for OpenCode Go/Zen (built into pi)
#   PI_BOX_SEARCH       1: enable Tavily web search / fetch tools (same as --search)
#   TAVILY_API_KEY      passed through when search is enabled (@tavily/pi-extension)
#   PI_BOX_HIDE         comma-separated provider ids to hide from /model
#                       (default "opencode", i.e. OpenCode Zen; "" hides nothing)
#   PI_BOX_CPUS / PI_BOX_MEMORY  VM sizing (default 4 / 4G)
#   PI_BOX_SSH          1: forward your ssh-agent into the box (container run --ssh)
#                       and, so `gh` works too, pass `gh auth token` from the host
#   PI_BOX_PROFILE      name of a profile: $PI_BOX_HOME/.env.NAME is read and its
#                       variables passed into the box (same as --profile NAME)
#   PI_BOX_DOCKER       1: let the agent use your Mac's Docker engine. Bridges your
#                       Docker socket to TCP with socat and sets up Apple's localhost
#                       DNS domain for container->Mac traffic (sudo, once per boot).
#                       The docker CLI is always in the image; this is per launch.
#   PI_BOX_DOCKER_SOCK  path to the Docker socket (auto-detected; colima first)
#   PI_BOX_HOST_ALIAS   the localhost domain name (default host.container.internal)
#   PI_BOX_HOST_ALIAS_IP the IP the domain maps to (default 203.0.113.113)
#   PI_ANTHROPIC_OAUTH_CLAUDE_CODE_VERSION  passed through for pi-anthropic-oauth
set -euo pipefail

BOX_IMAGE="pi-box"
BOX_NAME_PREFIX="pi"
BOX_ENV_PREFIX="PI_BOX"
BOX_CAN_SYNC=1

PI_VERSION="${PI_BOX_VERSION:-latest}"
PI_BOX_HOME="${PI_BOX_HOME:-$HOME/.pi-box}"
PI_AGENT_HOME="$PI_BOX_HOME/.pi/agent"   # pi reads it as /root/.pi/agent
BOX_HOME="$PI_BOX_HOME"
BOX_KEEP=(.pi)

# ----------------------------------------------------------------- lib ------
# agent-box-lib.bash sits next to this script. Symlinks are followed, so
# `ln -s .../tools/pi-box ~/bin/pi-box` still finds it.
self="${BASH_SOURCE[0]}"
while [[ -L $self ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ $self == /* ]] || self="$dir/$self"
done
dir="$(cd -P "$(dirname "$self")" && pwd)"
[[ -r "$dir/agent-box-lib.bash" ]] || {
  echo "error: agent-box-lib.bash not found next to $dir/$(basename "$self")" >&2
  exit 1
}
# shellcheck source=agent-box-lib.bash
source "$dir/agent-box-lib.bash"

# ---------------------------------------------------------------- flags -----
box_parse_args "$@"
set -- ${BOX_ARGS[@]+"${BOX_ARGS[@]}"}

# ------------------------------------------------------------- helpers ------
box_dockerfile_agent() {
  cat <<EOF
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION} \\
 && npm cache clean --force

ENTRYPOINT ["pi"]
EOF
}

sync_models() {
  # Ask the local LLM server what it serves (GET <root>/model/info) and rewrite
  # the "local" provider's model list in models.json. Other providers and any
  # hand-edited fields are kept. Seeds settings.json on first run.
  : "${LOCAL_LLM_URL:?set LOCAL_LLM_URL, e.g. https://llm.example.com/v1}"
  : "${LOCAL_LLM_API_KEY:?set LOCAL_LLM_API_KEY}"
  mkdir -p "$PI_AGENT_HOME/sessions"

  PI_AGENT_HOME="$PI_AGENT_HOME" PI_BOX_DEFAULT="${PI_BOX_DEFAULT:-}" python3 - <<'PYEOF'
import json, os, sys, urllib.request
from pathlib import Path

home = Path(os.environ["PI_AGENT_HOME"])
base = os.environ["LOCAL_LLM_URL"].rstrip("/")
key  = os.environ["LOCAL_LLM_API_KEY"]
root = base[:-3] if base.endswith("/v1") else base

req = urllib.request.Request(f"{root}/model/info",
                             headers={"Authorization": f"Bearer {key}"})
try:
    data = json.load(urllib.request.urlopen(req, timeout=15))["data"]
except Exception as e:
    sys.exit(f"error: could not fetch {root}/model/info: {e}")

models = []
for m in data:
    entry = {"id": m["model_name"]}
    ctx = (m.get("model_info") or {}).get("max_input_tokens")
    if ctx:
        entry["contextWindow"] = ctx
        entry["maxTokens"] = min(32768, ctx // 4)
    models.append(entry)
if not models:
    sys.exit("error: the server reported no models")

mpath = home / "models.json"
cfg = json.loads(mpath.read_text()) if mpath.is_file() else {}
prov = cfg.setdefault("providers", {}).setdefault("local", {})
prov["baseUrl"] = base
prov.setdefault("api", "openai-completions")
prov.setdefault("apiKey", "$LOCAL_LLM_API_KEY")   # resolved by pi at request time
prov.setdefault("compat", {"supportsDeveloperRole": False,
                           "supportsReasoningEffort": False})
prov["models"] = models
mpath.write_text(json.dumps(cfg, indent=2) + "\n")
print("==> synced %d local model(s): %s" % (len(models), ", ".join(m["id"] for m in models)),
      file=sys.stderr)

spath = home / "settings.json"
# Seed ponytail only on first run; if the user removes it from the settings,
# we leave it out.
settings = json.loads(spath.read_text()) if spath.is_file() else {
    "packages": ["git:github.com/DietrichGebert/ponytail"]}
if "defaultProvider" not in settings:
    default = os.environ.get("PI_BOX_DEFAULT") or "local/" + models[0]["id"]
    provider, _, model = default.partition("/")
    settings["defaultProvider"] = provider
    settings["defaultModel"] = model
    print("==> default model %s" % default, file=sys.stderr)
spath.write_text(json.dumps(settings, indent=2) + "\n")
PYEOF
}

ensure_settings() {
  # Runs every launch. Makes sure pi-hide-providers is listed in settings.json,
  # manages @tavily/pi-extension based on whether --search was passed, and
  # writes the hide rules from PI_BOX_HIDE. Does not touch models.
  mkdir -p "$PI_AGENT_HOME"
  PI_AGENT_HOME="$PI_AGENT_HOME" PI_BOX_HIDE="${PI_BOX_HIDE-opencode}" \
    PI_BOX_SEARCH="$(box_knob SEARCH)" python3 - <<'PYEOF'
import json, os
from pathlib import Path

home = Path(os.environ["PI_AGENT_HOME"])

spath = home / "settings.json"
settings = json.loads(spath.read_text()) if spath.is_file() else {}
before = json.dumps(settings, sort_keys=True)
pkgs = settings.setdefault("packages", [])

if not any(isinstance(p, str) and "pi-hide-providers" in p for p in pkgs):
    pkgs.append("npm:pi-hide-providers")

search_enabled = bool(os.environ.get("PI_BOX_SEARCH"))
has_tavily = any(isinstance(p, str) and "@tavily/pi-extension" in p for p in pkgs)

if search_enabled and not has_tavily:
    pkgs.append("npm:@tavily/pi-extension")
elif not search_enabled and has_tavily:
    settings["packages"] = [p for p in pkgs if not (isinstance(p, str) and "@tavily/pi-extension" in p)]

if json.dumps(settings, sort_keys=True) != before:
    spath.write_text(json.dumps(settings, indent=2) + "\n")

hide = [p.strip() for p in os.environ["PI_BOX_HIDE"].split(",") if p.strip()]
hpath = home / "hide-providers.json"
if hide:
    hpath.write_text(json.dumps({"hide": [{"provider": p} for p in hide]}, indent=2) + "\n")
elif hpath.is_file():
    hpath.unlink()
PYEOF
}

# ---------------------------------------------------------------- main ------
if [[ -n $CLEAN ]]; then
  box_clean "$CLEAN"
  exit 0
fi

if [[ $SYNC_ONLY -eq 1 ]]; then
  sync_models
  exit 0
fi

box_require_runtime
box_ensure_image "$REBUILD" "$BUILD_ONLY" "pi@$PI_VERSION"

if [[ $BUILD_ONLY -eq 1 ]]; then
  exit 0
fi

if [[ $SYNC -eq 1 || ! -f "$PI_AGENT_HOME/models.json" ]]; then
  sync_models
fi
ensure_settings

box_docker_bridge

# pi keeps its per-project sessions keyed by path, and the project is mounted at
# its Mac path, so they stay separate per project.
# not exec: the socat trap must outlive pi
box_run_args

BOX_SEARCH_ENV=()
if [[ -n "$(box_knob SEARCH)" ]]; then
  [[ -n "${TAVILY_API_KEY:-}" ]] || {
    echo "error: --search needs TAVILY_API_KEY set in your environment (or profile)" >&2
    exit 1
  }
  BOX_SEARCH_ENV=(--env TAVILY_API_KEY)
fi

box_run "${BOX_RUN_ARGS[@]}" \
  --env LOCAL_LLM_API_KEY \
  --env OPENCODE_API_KEY \
  ${BOX_SEARCH_ENV[@]+"${BOX_SEARCH_ENV[@]}"} \
  --env PI_ANTHROPIC_OAUTH_CLAUDE_CODE_VERSION \
  "$BOX_IMAGE" "$@"
