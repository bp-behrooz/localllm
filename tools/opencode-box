#!/usr/bin/env bash
# opencode-box: run OpenCode in a `container` VM (podman on Linux) confined to
# $PWD, with all permissions granted (the container is the sandbox).
#
#   opencode-box [opencode args...]  run (builds the image / syncs models on first use)
#   opencode-box --rebuild [args...] delete existing image, rebuild, then run
#   opencode-box --build-only        (re)build the image and exit
#   opencode-box --sync [args...]    refresh the local model list, then run
#   opencode-box --sync-only         refresh the local model list and exit
#   opencode-box --ssh [args...]     forward your ssh-agent into the box, and pass the
#                                    host's gh token along (same as OC_BOX_SSH=1)
#   opencode-box --docker [args...]  let the agent use the host's Docker / podman
#                                    (same as OC_BOX_DOCKER=1)
#   opencode-box --search [args...]  enable Tavily web search MCP tools
#                                    (same as OC_BOX_SEARCH=1; needs TAVILY_API_KEY)
#   opencode-box --profile=NAME      read $OC_BOX_HOME/.env.NAME (lines like
#                                    `export SOME_VAR=SOME_VAL`) and pass its
#                                    variables into the box (same as OC_BOX_PROFILE; or --profile NAME)
#   opencode-box --clean             drop the box's runtimes and caches, keep its config
#   opencode-box --clean-all         delete OC_BOX_HOME entirely (asks first)
#   opencode-box --shell [args]      bash in the box instead of the agent, for debugging
#
# OC_BOX_HOME is the box's entire /root, so anything the agent installs into the
# home directory survives the container being thrown away: mise runtimes, gems,
# ~/.npm, ~/.cargo, shell history. `mise use ruby@4.0.2 && bundle install` is a
# one-off, not a per-launch cost. System packages (apt) are not covered — those
# still belong in the image. --clean empties it again.
#
# Language runtimes come from mise: its shims are on PATH, so a project's own
# mise.toml applies in the non-interactive shells the agent runs commands in.
# See tools/README.md for the customization options.
#
# Requires: Apple Silicon, macOS 26, `container` CLI (brew install container),
# or Linux with rootless podman (see tools/README.md), and agent-box-lib.bash
# sitting next to this script.
#
# Env knobs:
#   OC_BOX_VERSION      npm version/tag of opencode-ai (default "latest")
#   OC_BOX_HOME         host dir for the box's own config/state (default ~/.opencode-box)
#   LOCAL_LLM_URL       OpenAI-compatible base URL of your LLM server,
#                       e.g. https://llm.example.com/v1
#   LOCAL_LLM_API_KEY   its API key; passed into the container, never written to disk
#   OC_BOX_DEFAULT      model a sync makes the current one, e.g. "localllm/qwen3-coder"
#                       or "opencode-go/minimax-m2.7" (default localllm/<first synced
#                       model>, i.e. the server's preloaded one); switching models in
#                       opencode sticks until the next sync
#   OPENCODE_API_KEY    passed through for OpenCode Go (built in)
#   OC_BOX_SEARCH       1 to enable Tavily web search MCP tools (same as --search)
#   TAVILY_API_KEY      passed through when search is enabled (tavily-mcp)
#   OC_BOX_HIDE         comma-separated provider ids to disable
#                       (default "opencode", i.e. OpenCode Zen; "" disables nothing)
#   OC_BOX_DOCKER       1 to expose the Mac's Docker daemon to the box (see notes)
#   OC_BOX_DOCKER_SOCK  path to the Docker socket (auto-detected; colima first)
#   OC_BOX_SSH          1 to forward your ssh-agent into the box (container run --ssh)
#                       and, so `gh` works too, pass `gh auth token` from the host
#   OC_BOX_PROFILE      name of a profile: $OC_BOX_HOME/.env.NAME is read and its
#                       variables passed into the box (same as --profile NAME)
#   OC_BOX_HOST_ALIAS   localhost domain name (default host.container.internal)
#   OC_BOX_HOST_ALIAS_IP the IP the domain maps to (default 203.0.113.113)
#   OC_BOX_CPUS / OC_BOX_MEMORY  VM sizing (default 4 / 4G)
set -euo pipefail

BOX_IMAGE="opencode-box"
BOX_NAME_PREFIX="oc"
BOX_ENV_PREFIX="OC_BOX"
BOX_CAN_SYNC=1

OC_VERSION="${OC_BOX_VERSION:-latest}"
OC_BOX_HOME="${OC_BOX_HOME:-$HOME/.opencode-box}"
PROVIDER="localllm"
BOX_HOME="$OC_BOX_HOME"
BOX_KEEP=(.config/opencode .local/share/opencode .local/state/opencode)

# ----------------------------------------------------------------- lib ------
# agent-box-lib.bash sits next to this script. Symlinks are followed, so
# `ln -s .../tools/opencode-box ~/bin/opencode-box` still finds it.
self="${BASH_SOURCE[0]}"
while [[ -L $self ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ $self == /* ]] || self="$dir/$self"
done
dir="$(cd -P "$(dirname "$self")" && pwd)"
[[ -r "$dir/agent-box-lib.bash" ]] || {
  echo "error: agent-box-lib.bash not found next to $dir/$(basename "$self")" >&2
  exit 1
}
# shellcheck source=agent-box-lib.bash
source "$dir/agent-box-lib.bash"

# ---------------------------------------------------------------- flags -----
box_parse_args "$@"
set -- ${BOX_ARGS[@]+"${BOX_ARGS[@]}"}

# ------------------------------------------------------------- helpers ------
box_dockerfile_agent() {
  cat <<EOF
RUN npm install -g opencode-ai@${OC_VERSION} \\
 && npm cache clean --force

# No XDG overrides needed: /root as a whole is the persisted mount, so the
# defaults (~/.config/opencode, ~/.local/share/opencode) already land in it.

ENTRYPOINT ["opencode"]
EOF
}

config_path() { echo "$OC_BOX_HOME/.config/opencode/opencode.json"; }
# opencode's last-used models; the first valid "recent" entry is what it starts on
state_path() { echo "$OC_BOX_HOME/.local/state/opencode/model.json"; }

sync_models() {
  # Ask the local LLM server what it serves (GET <root>/model/info) and rewrite
  # the localllm provider's models map. Other providers and hand-edited fields
  # are kept. Seeds the config on first run. Puts the default model first in
  # opencode's recent models, so that's where the next launch starts.
  : "${LOCAL_LLM_URL:?set LOCAL_LLM_URL, e.g. https://llm.example.com/v1}"
  : "${LOCAL_LLM_API_KEY:?set LOCAL_LLM_API_KEY}"
  mkdir -p "$(dirname "$(config_path)")"

  OC_CONFIG="$(config_path)" OC_STATE="$(state_path)" OC_BOX_DEFAULT="${OC_BOX_DEFAULT:-}" PROVIDER="$PROVIDER" \
    python3 - <<'PYEOF'
import json, os, sys, urllib.request
from pathlib import Path

cpath    = Path(os.environ["OC_CONFIG"])
base     = os.environ["LOCAL_LLM_URL"].rstrip("/")
key      = os.environ["LOCAL_LLM_API_KEY"]
provider = os.environ["PROVIDER"]
root     = base[:-3] if base.endswith("/v1") else base

req = urllib.request.Request(f"{root}/model/info",
                             headers={"Authorization": f"Bearer {key}"})
try:
    data = json.load(urllib.request.urlopen(req, timeout=15))["data"]
except Exception as e:
    sys.exit(f"error: could not fetch {root}/model/info: {e}")

models = {}
for m in data:
    name = m["model_name"]
    entry = {"name": name}
    ctx = (m.get("model_info") or {}).get("max_input_tokens")
    if ctx:
        entry["limit"] = {"context": ctx, "output": min(32768, ctx // 4)}
    models[name] = entry
if not models:
    sys.exit("error: the server reported no models")

# Seed ponytail only on first run; if the user removes it from the config,
# we leave it out.
cfg = json.loads(cpath.read_text()) if cpath.is_file() else {
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["@dietrichgebert/ponytail"]}
prov = cfg.setdefault("provider", {}).setdefault(provider, {})
prov.setdefault("npm", "@ai-sdk/openai-compatible")
prov.setdefault("name", "Local LLM")
opts = prov.setdefault("options", {})
opts["baseURL"] = base
opts.setdefault("apiKey", "{env:LOCAL_LLM_API_KEY}")   # resolved by opencode at runtime
prov["models"] = models

# A "model" in the config outranks the recent models, so it would undo every
# switch made inside opencode on the next launch. Start there via the recent
# list instead; earlier versions of this script wrote the pin, so drop it.
if cfg.pop("model", None):
    print("==> removed the config's pinned model", file=sys.stderr)
cpath.write_text(json.dumps(cfg, indent=2) + "\n")

default = os.environ.get("OC_BOX_DEFAULT") or f"{provider}/{next(iter(models))}"
pid, _, mid = default.partition("/")
spath = Path(os.environ["OC_STATE"])
try:
    state = json.loads(spath.read_text())
except (OSError, ValueError):
    state = {}
recent = [m for m in state.get("recent", [])
          if (m.get("providerID"), m.get("modelID")) != (pid, mid)]
state["recent"] = [{"providerID": pid, "modelID": mid}, *recent]
spath.parent.mkdir(parents=True, exist_ok=True)
spath.write_text(json.dumps(state, indent=2) + "\n")
print("==> current model %s" % default, file=sys.stderr)
print("==> synced %d local model(s): %s" % (len(models), ", ".join(models)), file=sys.stderr)
PYEOF
}

ensure_settings() {
  # Every launch: full permissions (the VM is the boundary), the provider
  # blocklist from OC_BOX_HIDE, and the Tavily MCP server when --search is enabled.
  mkdir -p "$(dirname "$(config_path)")"
  OC_CONFIG="$(config_path)" OC_BOX_HIDE="${OC_BOX_HIDE-opencode}" \
    OC_BOX_SEARCH="$(box_knob SEARCH)" python3 - <<'PYEOF'
import json, os
from pathlib import Path

cpath = Path(os.environ["OC_CONFIG"])
cfg = json.loads(cpath.read_text()) if cpath.is_file() else {"$schema": "https://opencode.ai/config.json"}
before = json.dumps(cfg, sort_keys=True)

cfg["permission"] = "allow"
hide = [p.strip() for p in os.environ["OC_BOX_HIDE"].split(",") if p.strip()]
if hide:
    cfg["disabled_providers"] = hide
else:
    cfg.pop("disabled_providers", None)

search_enabled = bool(os.environ.get("OC_BOX_SEARCH"))
mcp = cfg.setdefault("mcp", {})
if search_enabled:
    mcp["tavily"] = {
        "type": "local",
        "command": ["npx", "-y", "tavily-mcp"],
        "environment": {
            "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
        },
        "enabled": True
    }
else:
    mcp.pop("tavily", None)

if not mcp:
    cfg.pop("mcp", None)

if json.dumps(cfg, sort_keys=True) != before:
    cpath.write_text(json.dumps(cfg, indent=2) + "\n")
PYEOF
}

# ---------------------------------------------------------------- main ------
if [[ -n $CLEAN ]]; then
  box_clean "$CLEAN"
  exit 0
fi

if [[ $SYNC_ONLY -eq 1 ]]; then
  sync_models
  exit 0
fi

box_require_runtime
box_ensure_image "$REBUILD" "$BUILD_ONLY" "opencode-ai@$OC_VERSION"

if [[ $BUILD_ONLY -eq 1 ]]; then
  exit 0
fi

if [[ $SYNC -eq 1 || ! -f "$(config_path)" ]]; then
  sync_models
fi
ensure_settings

box_docker_bridge

# not exec: the socat trap must outlive opencode
box_run_args

BOX_SEARCH_ENV=()
if [[ -n "$(box_knob SEARCH)" ]]; then
  [[ -n "${TAVILY_API_KEY:-}" ]] || {
    echo "error: --search needs TAVILY_API_KEY set in your environment (or profile)" >&2
    exit 1
  }
  BOX_SEARCH_ENV=(--env TAVILY_API_KEY)
fi

box_run "${BOX_RUN_ARGS[@]}" \
  --env LOCAL_LLM_API_KEY \
  --env OPENCODE_API_KEY \
  ${BOX_SEARCH_ENV[@]+"${BOX_SEARCH_ENV[@]}"} \
  "$BOX_IMAGE" "$@"
