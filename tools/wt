#!/usr/bin/env bash
# wt: manage git worktrees under <project_root>/../${WT_DIR:-worktrees}/.
#     Default layout is <repo>/<branch>; with -g / WT_LAYOUT=branch it becomes
#     <branch>/<repo>, so one feature dir holds a worktree of every repo.
#
#   wt [ls]                              list worktrees with dirty / ahead-behind / box status
#   wt add [-g] [-w] <branch> [base]     create worktree (-g group by branch, -w moves changes)
#   wt add --pr <num|url> [branch]       fetch GitHub PR into a worktree (default branch: pr-<num>)
#   wt rm [-f] [--repos] [branch]        remove worktree, branch, and its per-worktree box data
#   wt merge [--repos] [--rebase|--squash] [branch] merge branch into main worktree, then wt rm it
#   wt ocr [--pr <num> | branch] [args]  run ocr-box review in the worktree against main branch
#   wt path [-m | branch]                print worktree path (-m or no arg for main worktree)
#   wt cd [-m | branch]                  same as path; `cd "$(wt cd x)"` in bash
#   wt init [fish]                       print fish shell wrapper (auto-cd on add/rm/merge/ocr/cd)
#
# Env knobs:
#   WT_DIR      sibling parent directory name under <project_root>/.. (default "worktrees")
#   WT_LAYOUT   repo (default) = <repo>/<branch>; branch = <branch>/<repo>
set -euo pipefail

case "${1:-}" in
-h | --help | help)
  sed -n '2,18s/^# \{0,1\}//p' "$0"
  exit 0
  ;;
init)
  cat <<'FISH'
function wt --wraps="git worktree"
    switch $argv[1]
        case add
            set -l dir (command wt $argv); or return
            test -d "$dir"; and cd "$dir"
        case cd
            set -l dir (command wt cd $argv[2..]); or return
            test -d "$dir"; and cd "$dir"
        case rm remove merge
            set -l main (command wt path -m 2>/dev/null)
            command wt $argv; or return
            test -d "$PWD"; or test -z "$main"; or cd "$main"
        case ocr
            set -l f (mktemp)
            WT_CD_FILE=$f command wt $argv
            set -l rc $status
            if test -s "$f"
                set -l dir (cat "$f")
                test -d "$dir"; and cd "$dir"
            end
            rm -f "$f"
            return $rc
        case '*'
            command wt $argv
    end
end
complete -c wt -f
function __wt_sub
    set -l skip -h --help
    for w in (commandline -opc)[2..]
        if not contains -- $w $skip; and string match -qr '^[a-z]' -- $w
            echo $w; return
        end
    end
end
function __wt_branches
    git worktree list --porcelain 2>/dev/null | string replace -r -f '^branch refs/heads/' ''
end
complete -c wt -n "test -z (__wt_sub)" -a "add rm remove merge ocr cd path ls list init"
complete -c wt -n "__fish_seen_subcommand_from init" -a fish
complete -c wt -n "__fish_seen_subcommand_from add" -s w -l with-changes -d 'move uncommitted changes'
complete -c wt -n "__fish_seen_subcommand_from add" -s g -l group -d 'group by branch (<branch>/<repo>)'
complete -c wt -n "__fish_seen_subcommand_from add" -l pr -d 'fetch GitHub PR'
complete -c wt -n "__fish_seen_subcommand_from rm remove" -s f -l force -d 'force remove'
complete -c wt -n "__fish_seen_subcommand_from merge" -l rebase -s r -d 'rebase then ff'
complete -c wt -n "__fish_seen_subcommand_from merge" -l squash -s s -d 'squash merge'
complete -c wt -n "__fish_seen_subcommand_from rm remove merge" -l repos -d 'every repo in the feature'
complete -c wt -n "__fish_seen_subcommand_from path cd" -s m -l main -d 'main worktree'
complete -c wt -n "__fish_seen_subcommand_from rm remove merge ocr path cd" -a "(__wt_branches)"
complete -c wt -n "__fish_seen_subcommand_from add" -a "(__wt_branches)"
complete -c wt -n "__fish_seen_subcommand_from ocr" -l pr -d 'review a PR'
complete -c wt -n "__fish_seen_subcommand_from ocr" -l profile -r -d 'ocr-box profile'
FISH
  exit 0
  ;;
esac

self="${BASH_SOURCE[0]}"
while [[ -L $self ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ $self == /* ]] || self="$dir/$self"
done
self="$(cd -P "$(dirname "$self")" && pwd)/$(basename "$self")"
tools_dir="$(dirname "$self")"

main_root="" project="" wt_root="" wt_base=""
common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || common_dir=""
if [[ -n "$common_dir" ]]; then
  main_root="$(dirname "$common_dir")"
  project="$(basename "$main_root")"
  wt_root="$(cd -P "$main_root/.." && pwd)/${WT_DIR:-worktrees}"
  wt_base="$wt_root/$project"
fi
wt_layout="${WT_LAYOUT:-repo}"

# Slugify slashes to dashes so `basename $PWD` (used by *-box for container and
# volume names) stays unique for branches like feat/auth.
wt_slug() { printf '%s' "${1//\//-}"; }

# Path of this repo's worktree for a branch. Prefers whichever layout already
# has it on disk; creation follows WT_LAYOUT / -g (repo = <repo>/<branch>,
# branch = <branch>/<repo>).
wt_dir() {
  local slug old new
  slug="$(wt_slug "$1")"
  old="$wt_base/$slug"
  new="$wt_root/$slug/$project"
  if [[ -d "$old" ]]; then
    printf '%s\n' "$old"
  elif [[ -d "$new" ]]; then
    printf '%s\n' "$new"
  elif [[ "$wt_layout" == branch ]]; then
    printf '%s\n' "$new"
  else
    printf '%s\n' "$old"
  fi
}

# Every git worktree directly under a feature group dir.
wt_repo_dirs() {
  local d
  for d in "$1"/*/; do
    [[ -e "$d/.git" ]] && printf '%s\n' "${d%/}"
  done
}

main_branch() {
  local root="${1:-$main_root}" b
  b="$(git -C "$root" branch --show-current)"
  [[ -n "$b" ]] && { printf '%s\n' "$b"; return; }
  git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || printf 'HEAD\n'
}

# Same <slug>-<cksum> key as _box_data_prefix in agent-box-lib.bash.
wt_box_proj() {
  local d="$1"
  printf '%s-%s' "$(basename "$d" | tr -c 'A-Za-z0-9_.\n-' '-')" "$(printf '%s' "$d" | cksum | cut -d' ' -f1)"
}

wt_box_running() {
  local proj lock pid
  proj="$(wt_box_proj "$1")"
  for lock in "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/agentbox-locks"/*"-$proj"; do
    [[ -d "$lock" ]] || continue
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

wt_box_cleanup() {
  local proj ctr vols=() v db lock
  proj="$(wt_box_proj "$1")"
  if [[ $(uname -s) == Linux ]]; then
    command -v podman >/dev/null 2>&1 && ctr=podman || ctr=
    if [[ -n "$ctr" ]]; then
      while IFS= read -r v; do
        [[ $v == agentbox-*-"$proj"-* ]] && vols+=("$v")
      done < <(podman volume ls -q 2>/dev/null || true)
    fi
  else
    command -v container >/dev/null 2>&1 && ctr=container || ctr=
    if [[ -n "$ctr" ]]; then
      while IFS= read -r v; do
        [[ $v == agentbox-*-"$proj"-* ]] && vols+=("$v")
      done < <(container volume list --format json 2>/dev/null |
        grep -o '"name" *: *"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/' || true)
    fi
  fi
  if [[ ${#vols[@]} -gt 0 ]]; then
    "$ctr" volume rm "${vols[@]}" >/dev/null 2>&1 || true
  fi
  for db in "${OC_BOX_HOME:-$HOME/.opencode-box}/.local/share/opencode/agentbox-"*"-$proj.db"*; do
    [[ -e "$db" ]] && rm -f "$db"
  done
  for lock in "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/agentbox-locks"/*"-$proj"; do
    [[ -d "$lock" ]] && rm -rf "$lock"
  done
  return 0
}

# Resolve target worktree -> sets WT_TARGET_DIR and WT_TARGET_BRANCH.
wt_resolve() {
  [[ -n "$main_root" ]] || {
    echo "error: not in a git repository" >&2
    exit 1
  }
  if [[ $# -eq 0 || -z "$1" ]]; then
    WT_TARGET_DIR="$(git rev-parse --path-format=absolute --show-toplevel)"
    [[ "$WT_TARGET_DIR" != "$main_root" ]] || {
      echo "error: in main worktree; pass a branch name" >&2
      exit 1
    }
    WT_TARGET_BRANCH="$(git branch --show-current)"
  else
    WT_TARGET_DIR="$(wt_dir "$1")"
    if [[ -d "$WT_TARGET_DIR" ]]; then
      WT_TARGET_BRANCH="$(git -C "$WT_TARGET_DIR" branch --show-current)"
    else
      WT_TARGET_BRANCH="$1"
    fi
  fi
}

# Run a command in every repo worktree of the feature group that contains $PWD
# (or is $PWD itself outside a repo). Used by --repos.
wt_repos_foreach() {
  local cmd="$1" top group d rc=0 dirs=()
  shift
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$top" ]]; then
    [[ "$top" == "$main_root" ]] && {
      echo "error: --repos: run from a feature workspace, not the main worktree" >&2
      return 1
    }
    group="$(dirname "$top")"
  else
    group="$PWD"
  fi
  while IFS= read -r d; do dirs+=("$d"); done < <(wt_repo_dirs "$group")
  [[ ${#dirs[@]} -gt 0 ]] || {
    echo "error: --repos: no repo worktrees under $group" >&2
    return 1
  }
  for d in "${dirs[@]}"; do
    (cd "$d" && "$self" "$cmd" "$@") || rc=$?
  done
  return $rc
}

# wt_ls_path LINE PATH MAIN_ROOT MAIN_BRANCH: print one worktree with its tags.
wt_ls_path() {
  local line="$1" wt_path="$2" root="$3" mb="$4" tags=() counts ahead behind
  if [[ -d "$wt_path" ]]; then
    [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]] && tags+=("dirty")
    if [[ "$wt_path" != "$root" ]]; then
      counts="$(git -C "$wt_path" rev-list --left-right --count "$mb...HEAD" 2>/dev/null || true)"
      if [[ -n "$counts" ]]; then
        behind="${counts%%$'\t'*}"
        ahead="${counts##*$'\t'}"
        [[ "${ahead:-0}" -gt 0 ]] && tags+=("+$ahead")
        [[ "${behind:-0}" -gt 0 ]] && tags+=("-$behind")
      fi
    fi
    wt_box_running "$wt_path" && tags+=("running")
  fi
  if [[ ${#tags[@]} -gt 0 ]]; then
    IFS=,
    printf '%s  (%s)\n' "$line" "${tags[*]}"
    unset IFS
  else
    printf '%s\n' "$line"
  fi
}

wt_ls_repo() {
  local root="$1" mb line wt_path
  mb="$(main_branch "$root")"
  while IFS= read -r line; do
    wt_path="${line%% *}"
    wt_ls_path "$line" "$wt_path" "$root" "$mb"
  done < <(git -C "$root" worktree list)
}

cmd="${1:-ls}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
add)
  [[ -n "$main_root" ]] || {
    echo "error: not in a git repository" >&2
    exit 1
  }
  with_changes=0
  pr=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -w | --with-changes)
      with_changes=1
      shift
      ;;
    -g | --group)
      wt_layout=branch
      shift
      ;;
    --pr)
      [[ $# -ge 2 ]] || { echo "error: --pr requires a number or URL" >&2; exit 1; }
      pr="${2##*/}"
      shift 2
      ;;
    --pr=*)
      pr="${1#--pr=}"
      pr="${pr##*/}"
      shift
      ;;
    -*)
      echo "error: unknown flag '$1'" >&2
      exit 1
      ;;
    *)
      break
      ;;
    esac
  done

  if [[ -n "$pr" ]]; then
    [[ "$pr" =~ ^[0-9]+$ ]] || { echo "error: invalid PR number '$pr'" >&2; exit 1; }
    branch="${1:-pr-$pr}"
    dir="$(wt_dir "$branch")"
    mkdir -p "$(dirname "$dir")"
    if [[ -d "$dir" ]]; then
      git -C "$dir" fetch origin "pull/$pr/head" >&2
      git -C "$dir" merge --ff-only FETCH_HEAD >&2
    else
      git -C "$main_root" fetch origin "pull/$pr/head:$branch" >&2
      git worktree add "$dir" "$branch" >&2
    fi
  else
    [[ $# -ge 1 && $# -le 2 ]] || {
      echo "usage: wt add [-g] [-w] <branch> [base] | wt add --pr <num> [branch]" >&2
      exit 1
    }
    branch="$1"
    base="${2:-HEAD}"
    dir="$(wt_dir "$branch")"
  fi

  stashed=0
  if [[ $with_changes -eq 1 && -n "$(git status --porcelain)" ]]; then
    git stash push -u -q -m "wt-add-$branch"
    stashed=1
  fi

  if [[ ! -d "$dir" ]]; then
    mkdir -p "$(dirname "$dir")"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$dir" "$branch" >&2
    elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git worktree add --track -b "$branch" "$dir" "origin/$branch" >&2
    else
      git worktree add -b "$branch" "$dir" "$base" >&2
    fi
  fi

  # Copy (never symlink) untracked .env* files from main_root so *-box VMs can read them.
  for f in "$main_root"/.env*; do
    [[ -f "$f" && ! -e "$dir/$(basename "$f")" ]] && cp -p "$f" "$dir/"
  done

  if [[ $stashed -eq 1 ]]; then
    git -C "$dir" stash pop -q >&2
  fi
  printf '%s\n' "$dir"
  ;;

rm | remove)
  args=()
  repos=0
  for a in "$@"; do
    if [[ "$a" == --repos ]]; then repos=1; else args+=("$a"); fi
  done
  if [[ $repos -eq 1 ]]; then
    if [[ ${#args[@]} -gt 0 ]]; then
      wt_repos_foreach rm "${args[@]}"
    else
      wt_repos_foreach rm
    fi
    exit
  fi
  if [[ ${#args[@]} -gt 0 ]]; then set -- "${args[@]}"; else set --; fi
  force=()
  bflag="-d"
  if [[ "${1:-}" == "-f" || "${1:-}" == "--force" ]]; then
    force=(--force)
    bflag="-D"
    shift
  fi
  wt_resolve ${1+"$1"}
  cd "$main_root"
  for f in "$main_root"/.env*; do
    base="$(basename "$f")"
    if [[ -f "$f" ]] && cmp -s "$f" "$WT_TARGET_DIR/$base" &&
      ! git -C "$WT_TARGET_DIR" ls-files --error-unmatch "$base" >/dev/null 2>&1; then
      rm -f "$WT_TARGET_DIR/$base"
    fi
  done
  git worktree remove ${force[@]+"${force[@]}"} "$WT_TARGET_DIR" >&2
  rmdir "$(dirname "$WT_TARGET_DIR")" 2>/dev/null || true
  if [[ -n "$WT_TARGET_BRANCH" ]]; then
    git -C "$main_root" branch "$bflag" "$WT_TARGET_BRANCH" >&2
  fi
  wt_box_cleanup "$WT_TARGET_DIR"
  ;;

merge)
  args=()
  repos=0
  for a in "$@"; do
    if [[ "$a" == --repos ]]; then repos=1; else args+=("$a"); fi
  done
  if [[ $repos -eq 1 ]]; then
    if [[ ${#args[@]} -gt 0 ]]; then
      wt_repos_foreach merge "${args[@]}"
    else
      wt_repos_foreach merge
    fi
    exit
  fi
  if [[ ${#args[@]} -gt 0 ]]; then set -- "${args[@]}"; else set --; fi
  strategy="merge"
  case "${1:-}" in
  --rebase | -r)
    strategy="rebase"
    shift
    ;;
  --squash | -s)
    strategy="squash"
    shift
    ;;
  esac
  wt_resolve ${1+"$1"}
  [[ -n "$WT_TARGET_BRANCH" ]] || {
    echo "error: worktree at $WT_TARGET_DIR has no branch checked out" >&2
    exit 1
  }
  cd "$main_root"
  mb="$(main_branch)"
  case "$strategy" in
  rebase)
    git -C "$WT_TARGET_DIR" rebase "$mb" >&2
    git -C "$main_root" merge --ff-only "$WT_TARGET_BRANCH" >&2
    "$self" rm "$WT_TARGET_BRANCH"
    ;;
  squash)
    git -C "$main_root" merge --squash "$WT_TARGET_BRANCH" >&2
    git -C "$main_root" commit --no-edit >&2
    "$self" rm -f "$WT_TARGET_BRANCH"
    ;;
  merge)
    git -C "$main_root" merge --no-edit "$WT_TARGET_BRANCH" >&2
    "$self" rm "$WT_TARGET_BRANCH"
    ;;
  esac
  ;;

ocr)
  [[ -n "$main_root" ]] || {
    echo "error: not in a git repository" >&2
    exit 1
  }
  pr=""
  target=""
  box_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --pr)
      [[ $# -ge 2 ]] || { echo "error: --pr requires a number or URL" >&2; exit 1; }
      pr="$2"
      shift 2
      ;;
    --pr=*)
      pr="${1#--pr=}"
      shift
      ;;
    --profile)
      [[ $# -ge 2 ]] || { echo "error: --profile requires an argument" >&2; exit 1; }
      box_args+=("$1" "$2")
      shift 2
      ;;
    --)
      shift
      box_args+=("$@")
      break
      ;;
    -*)
      box_args+=("$1")
      shift
      ;;
    *)
      if [[ -z "$target" && -z "$pr" && ${#box_args[@]} -eq 0 ]] &&
        { [[ -d "$(wt_dir "$1")" ]] || git show-ref --verify --quiet "refs/heads/$1" 2>/dev/null; }; then
        target="$1"
      else
        box_args+=("$1")
      fi
      shift
      ;;
    esac
  done

  if [[ -n "$pr" ]]; then
    dir="$("$self" add --pr "$pr")"
  elif [[ -n "$target" ]]; then
    dir="$("$self" add "$target")"
  else
    dir="$(git rev-parse --path-format=absolute --show-toplevel)"
  fi
  [[ -n "${WT_CD_FILE:-}" ]] && printf '%s\n' "$dir" >"$WT_CD_FILE"

  mb="$(main_branch)"
  # Default to reviewing the branch/PR commit range against main_branch when no
  # subcommand (review/scan/session) was given; if the working tree itself has
  # uncommitted changes and wasn't --pr, bare `review` reviews those changes.
  has_sub=0
  for a in ${box_args[@]+"${box_args[@]}"}; do
    case "$a" in
    review | scan | session | init | config) has_sub=1 ;;
    esac
  done
  if [[ $has_sub -eq 0 ]]; then
    if [[ -n "$pr" || -z "$(git -C "$dir" status --porcelain)" ]]; then
      box_args+=(review --from "$mb" --to HEAD)
    else
      box_args+=(review)
    fi
  fi
  (cd "$dir" && "$tools_dir/ocr-box" ${box_args[@]+"${box_args[@]}"})
  ;;

path | cd)
  if [[ $# -eq 0 || "${1:-}" == "-m" || "${1:-}" == "--main" ]]; then
    printf '%s\n' "$main_root"
  else
    wt_resolve "$1"
    printf '%s\n' "$WT_TARGET_DIR"
  fi
  ;;

ls | list)
  if [[ $# -gt 0 ]]; then
    [[ -n "$main_root" ]] || {
      echo "error: not in a git repository" >&2
      exit 1
    }
    git -C "$main_root" worktree list "$@"
    exit 0
  fi
  if [[ -n "$main_root" ]]; then
    wt_ls_repo "$main_root"
  else
    # Feature workspace: each subdir is a worktree of a different repo.
    while IFS= read -r d; do
      wt_ls_root="$(dirname "$(git -C "$d" rev-parse --path-format=absolute --git-common-dir)")"
      wt_ls_path "$d" "$d" "$wt_ls_root" "$(main_branch "$wt_ls_root")"
    done < <(wt_repo_dirs "$PWD")
  fi
  ;;

*)
  echo "error: unknown command '$cmd' (try: wt --help)" >&2
  exit 1
  ;;
esac
