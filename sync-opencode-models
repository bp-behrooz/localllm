#!/usr/bin/env python3
"""Sync OpenCode's localllm models from the localllm server.

Asks the server what's being served (with context sizes) and rewrites the
localllm provider's models map in opencode.json(c). Run after changing
presets on the gpu-box.

Endpoint and key come from the provider entry in the config; pass --base-url
(and --api-key) to override them or to bootstrap the provider — including the
config file itself — when it doesn't exist yet.
"""
import argparse
import json
import os
import re
import sys
import urllib.request
from pathlib import Path

PROVIDER = "localllm"

ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
ap.add_argument("--base-url", help="localllm endpoint, e.g. https://example.com/localllm/v1"
                " (persisted into the provider's baseURL)")
ap.add_argument("--api-key", help="localllm master key (persisted into the provider's apiKey)")
args = ap.parse_args()

candidates = [Path(p) for p in filter(None, [os.environ.get("OPENCODE_CONFIG")])]
candidates += [Path.home() / ".config/opencode/opencode.json",
               Path.home() / ".config/opencode/opencode.jsonc"]
CONFIG = next((p for p in candidates if p.is_file()), None)


def strip_jsonc(text):
    """Remove //, /* */ comments and trailing commas, respecting strings."""
    out, i, n, in_str, removed = [], 0, len(text), False, False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif c == "/" and text[i + 1:i + 2] == "/":
            removed = True
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif c == "/" and text[i + 1:i + 2] == "*":
            removed = True
            i = text.find("*/", i + 2)
            i = n if i < 0 else i + 2
            continue
        else:
            out.append(c)
        i += 1
    s = "".join(out)
    cleaned = re.sub(r",(\s*[}\]])", r"\1", s)
    return cleaned, removed or cleaned != s


had_jsonc = False
if CONFIG:
    cleaned, had_jsonc = strip_jsonc(CONFIG.read_text())
    cfg = json.loads(cleaned)
else:
    if not args.base_url:
        sys.exit("error: no opencode config found; pass --base-url (and --api-key) to create one\n"
                 f"looked at: {', '.join(map(str, candidates))}")
    CONFIG = candidates[0] if os.environ.get("OPENCODE_CONFIG") else candidates[1]
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    cfg = {"$schema": "https://opencode.ai/config.json"}

prov = cfg.setdefault("provider", {}).setdefault(PROVIDER, {})
prov.setdefault("npm", "@ai-sdk/openai-compatible")
prov.setdefault("name", "Local LLM")
opts = prov.setdefault("options", {})
if args.base_url:
    opts["baseURL"] = args.base_url
if args.api_key:
    opts["apiKey"] = args.api_key
base, key = opts.get("baseURL"), opts.get("apiKey")
if not (base and key):
    sys.exit(f"error: provider.{PROVIDER} in {CONFIG} has no baseURL/apiKey;"
             " pass --base-url and --api-key")

base = base.rstrip("/")
root = base[: -len("/v1")] if base.endswith("/v1") else base
req = urllib.request.Request(f"{root}/model/info", headers={"Authorization": f"Bearer {key}"})
data = json.load(urllib.request.urlopen(req))["data"]

models = {}
for m in data:
    name = m["model_name"]
    entry = {"name": name}
    ctx = (m.get("model_info") or {}).get("max_input_tokens")
    if ctx:
        entry["limit"] = {"context": ctx, "output": min(32768, ctx // 4)}
    models[name] = entry

if not models:
    sys.exit("error: the server reported no models")

prov["models"] = models
CONFIG.write_text(json.dumps(cfg, indent=2) + "\n")
if had_jsonc:
    print(f"note: {CONFIG} contained comments/trailing commas; rewritten as plain JSON")
print(f"updated {CONFIG}: {', '.join(models)}")
